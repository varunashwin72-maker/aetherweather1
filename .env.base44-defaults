# AetherWeather — Base44 sandbox defaults (placeholder values only).
#
# This file exists so the app can boot in the sandbox before real credentials
# are supplied. Compose loads it FIRST and /run/base44/app.env LAST, so any
# real value (Base44 Secrets) always overrides what is here.
#
# The Supabase pair below is a development placeholder: it satisfies the
# Supabase client's startup validation so the UI renders, but sign-in will not
# work until the real project URL and anon key are provided.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=development-placeholder-anon-key

# Default provider is keyless (Open-Meteo). Switch to "openweather" and provide
# VITE_WEATHER_API_KEY to use a keyed provider.
VITE_WEATHER_API_PROVIDER=open-meteo
VITE_WEATHER_API_KEY=

# Optional
VITE_MAP_API_KEY=
VITE_AIR_QUALITY_API_KEY=
